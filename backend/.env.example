# RUMES backend configuration — copy to `.env` and adjust.
SECRET_KEY=please-generate-a-long-random-secret
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./rumes.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=32
